{
  "name": "angeronia-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:favicon": "node scripts/retint-favicon.mjs",
    "build:logos": "node scripts/build-logos.mjs",
    "check:theme": "node scripts/retint-favicon.mjs --check && node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project=storybook"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.87.0",
    "@carbon/react": "^1.115.0",
    "@carbon/themes": "^11.80.0",
    "clsx": "^2.1.1",
    "next": "15.5.12",
    "next-themes": "^0.4.4",
    "react": "^19",
    "react-dom": "^19",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@carbon/colors": "^11.57.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "sass-embedded": "^1.103.1",
    "storybook": "^10.6.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
