{
  "name": "angeronia-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:slds": "slds-linter lint \"{app,components,stories}/**/*.css\" --config-eslint eslint.slds.config.mjs",
    "lint:slds:report": "slds-linter report \"{app,components,stories}/**/*.css\" --config-eslint eslint.slds.config.mjs",
    "build:theme": "node scripts/build-theme.mjs",
    "build:favicon": "node scripts/retint-favicon.mjs",
    "build:logos": "node scripts/build-logos.mjs",
    "check:theme": "node scripts/build-theme.mjs --check && node scripts/retint-favicon.mjs --check && node scripts/check-theme.mjs --check",
    "typecheck": "tsc --noEmit",
    "build:css": "node scripts/build-vendor-css.mjs",
    "predev": "npm run build:css",
    "prebuild": "npm run build:css",
    "pretypecheck": "npm run build:css",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "prestorybook": "npm run build:css",
    "prebuild-storybook": "npm run build:css",
    "test:storybook": "vitest run --project=storybook",
    "check:vendor-css": "node scripts/compare-vendor-css.mjs",
    "pretest:storybook": "npm run build:css",
    "precheck:vendor-css": "npm run build:css"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.87.0",
    "@salesforce-ux/design-system-2": "2.264.1",
    "@salesforce-ux/design-tokens": "4.1.0",
    "clsx": "^2.1.1",
    "next": "15.5.12",
    "next-themes": "^0.4.4",
    "react": "^19",
    "react-dom": "^19",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@carbon/colors": "^11.57.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@salesforce-ux/slds-linter": "^1.2.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
